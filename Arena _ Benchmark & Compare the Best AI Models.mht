<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#24292E">    D --&gt;|Encrypted Backup| G[Local Storage]</span></span>
<span class="line"><span style="color:#24292E">    D --&gt;|Encrypted Sync| F</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#24292E">    H[Security Monitoring] -.-&gt; C</span></span>
<span class="line"><span style="color:#24292E">    H -.-&gt; D</span></span>
