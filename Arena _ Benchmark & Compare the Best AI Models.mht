<span class="line"><span style="color:#005CC5">  COALESCE</span><span style="color:#24292E">(</span><span style="color:#005CC5">SUM</span><span style="color:#24292E">(</span><span style="color:#005CC5">e</span><span style="color:#24292E">.</span><span style="color:#005CC5">pending_amount</span><span style="color:#24292E">), </span><span style="color:#005CC5">0</span><span style="color:#24292E">) </span><span style="color:#D73A49">AS</span><span style="color:#24292E"> total_pending,</span></span>
<span class="line"><span style="color:#005CC5">  MAX</span><span style="color:#24292E">(</span><span style="color:#005CC5">e</span><span style="color:#24292E">.</span><span style="color:#005CC5">entry_date</span><span style="color:#24292E">) </span><span style="color:#D73A49">AS</span><span style="color:#24292E"> last_visit</span></span>
<span class="line"><span style="color:#D73A49">FROM</span><span style="color:#24292E"> customers c</span></span>
