<span class="line"><span style="color:#24292E">      &lt;</span><span style="color:#005CC5">Switch</span><span style="color:#6F42C1"> label</span><span style="color:#D73A49">=</span><span style="color:#032F62">"Entry के साथ Auto SMS"</span><span style="color:#6F42C1"> value</span><span style="color:#D73A49">=</span><span style="color:#24292E">{autoSendOnEntry} /&gt;</span></span>
<span class="line"><span style="color:#24292E">      &lt;</span><span style="color:#005CC5">Switch</span><span style="color:#6F42C1"> label</span><span style="color:#D73A49">=</span><span style="color:#032F62">"Payment Reminders (Weekly)"</span><span style="color:#6F42C1"> value</span><span style="color:#D73A49">=</span><span style="color:#24292E">{sendPaymentReminders} /&gt;</span></span>
<span class="line"><span style="color:#24292E">      </span></span>
<span class="line"><span style="color:#24292E">      &lt;</span><span style="color:#005CC5">Button</span><span style="color:#6F42C1"> onPress</span><span style="color:#D73A49">=</span><span style="color:#24292E">{() </span><span style="color:#D73A49">=&gt;</span><span style="color:#6F42C1"> showSMSPreview</span><span style="color:#24292E">()}&gt;</span></span>
<span class="line"><span style="color:#24292E">        Message Preview देखें</span></span>
<span class="line"><span style="color:#24292E">      &lt;/</span><span style="color:#005CC5">Button</span><span style="color:#24292E">&gt;</span></span>
