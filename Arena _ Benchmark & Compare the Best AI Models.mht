<span class="line"><span style="color:#D73A49">INSERT INTO</span><span style="color:#24292E"> entries_archive </span><span style="color:#D73A49">SELECT</span><span style="color:#D73A49"> *</span><span style="color:#D73A49"> FROM</span><span style="color:#24292E"> entries </span><span style="color:#D73A49">WHERE</span><span style="color:#24292E"> entry_date </span><span style="color:#D73A49">&lt;</span><span style="color:#D73A49"> date</span><span style="color:#24292E">(</span><span style="color:#032F62">'now'</span><span style="color:#24292E">, </span><span style="color:#032F62">'-2 years'</span><span style="color:#24292E">);</span></span>
