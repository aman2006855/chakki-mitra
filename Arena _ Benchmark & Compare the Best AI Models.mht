<span class="line"><span style="color:#032F62">      LIMIT 10</span></span>
<span class="line"><span style="color:#032F62">    `</span><span style="color:#24292E">);</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#D73A49">    for</span><span style="color:#24292E"> (</span><span style="color:#D73A49">const</span><span style="color:#005CC5"> sms</span><span style="color:#D73A49"> of</span><span style="color:#24292E"> pendingSMS) {</span></span>
<span class="line"><span style="color:#D73A49">      try</span><span style="color:#24292E"> {</span></span>
<span class="line"><span style="color:#D73A49">        await</span><span style="color:#6F42C1"> sendSMS</span><span style="color:#24292E">(sms.phone_number, sms.message);</span></span>
<span class="line"><span style="color:#24292E">        </span></span>
<span class="line"><span style="color:#D73A49">        await</span><span style="color:#24292E"> db.</span><span style="color:#6F42C1">update</span><span style="color:#24292E">(</span><span style="color:#032F62">'sms_queue'</span><span style="color:#24292E">, sms.id, {</span></span>
